<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PayloadDisplayName</key>
	<string>Claude Code Network Lockdown</string>
	<key>PayloadDescription</key>
	<string>Locks Claude Code down so sandboxed commands reach no network host, web and upload tools are denied, and only managed hooks, MCP servers, plugins and permission rules apply.</string>
	<key>PayloadIdentifier</key>
	<string>com.anthropic.claudecode.networklockdown</string>
	<key>PayloadOrganization</key>
	<string>Example Organization</string>
	<key>PayloadScope</key>
	<string>System</string>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadUUID</key>
	<string>921808D1-6840-46DF-8EB5-D50D5FB4A3C8</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
	<key>PayloadRemovalDisallowed</key>
	<true/>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>PayloadDisplayName</key>
			<string>Claude Code</string>
			<key>PayloadIdentifier</key>
			<string>com.anthropic.claudecode.networklockdown.E205D54D-8EA2-444A-ACCD-0741333A1C23</string>
			<key>PayloadType</key>
			<string>com.apple.ManagedClient.preferences</string>
			<key>PayloadUUID</key>
			<string>E205D54D-8EA2-444A-ACCD-0741333A1C23</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>PayloadContent</key>
			<dict>
				<key>com.anthropic.claudecode</key>
				<dict>
					<key>Forced</key>
					<array>
						<dict>
							<key>mcx_preference_settings</key>
							<dict>
								<key>allowManagedHooksOnly</key>
								<true/>
								<key>allowedHttpHookUrls</key>
								<array/>
								<key>allowManagedMcpServersOnly</key>
								<true/>
								<key>allowedMcpServers</key>
								<array/>
								<key>deniedMcpServers</key>
								<array>
									<dict>
										<key>serverName</key>
										<string>claude-in-chrome</string>
									</dict>
									<dict>
										<key>serverName</key>
										<string>computer-use</string>
									</dict>
									<dict>
										<key>serverName</key>
										<string>ide</string>
									</dict>
								</array>
								<key>allowManagedPermissionRulesOnly</key>
								<true/>
								<key>disableRemoteControl</key>
								<true/>
								<key>permissions</key>
								<dict>
									<key>ask</key>
									<array>
										<string>Bash</string>
									</array>
									<key>deny</key>
									<array>
										<string>WebFetch</string>
										<string>WebSearch</string>
										<string>Projects</string>
										<string>SendUserFile</string>
										<string>ShareOnboardingGuide</string>
										<string>Artifact</string>
									</array>
									<key>disableBypassPermissionsMode</key>
									<string>disable</string>
								</dict>
								<key>strictKnownMarketplaces</key>
								<array/>
								<key>strictPluginOnlyCustomization</key>
								<true/>
								<key>disableSideloadFlags</key>
								<true/>
								<key>crossSessionInbound</key>
								<string>refuse</string>
								<key>enableArtifact</key>
								<false/>
								<key>syncClaudeAiSkills</key>
								<false/>
								<key>syncClaudeAiPlugins</key>
								<false/>
								<key>sandbox</key>
								<dict>
									<key>enabled</key>
									<true/>
									<key>failIfUnavailable</key>
									<true/>
									<key>autoAllowBashIfSandboxed</key>
									<false/>
									<key>allowUnsandboxedCommands</key>
									<false/>
									<key>excludedCommands</key>
									<array/>
									<key>enableWeakerNestedSandbox</key>
									<false/>
									<key>enableWeakerNetworkIsolation</key>
									<false/>
									<key>network</key>
									<dict>
										<key>allowManagedDomainsOnly</key>
										<true/>
										<key>allowedDomains</key>
										<array/>
										<key>allowUnixSockets</key>
										<array/>
										<key>allowAllUnixSockets</key>
										<false/>
										<key>allowLocalBinding</key>
										<false/>
									</dict>
								</dict>
								<key>env</key>
								<dict>
									<key>DISABLE_ERROR_REPORTING</key>
									<string>1</string>
									<key>DISABLE_FEEDBACK_COMMAND</key>
									<string>1</string>
									<key>CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY</key>
									<string>1</string>
